<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" spacing="15.0" xmlns:fx="http://javafx.com/fxml/1" xmlns="http://javafx.com/javafx/23.0.1" fx:controller="fr.esiee.javafxtest.HelloController">
    <padding>
        <Insets left="25.0" right="25.0" top="25.0" bottom="25.0" />
    </padding>

    <HBox alignment="CENTER" spacing="15.0">
        <children>
            <Label text="Nom :" />
            <TextField fx:id="tf_inputName" promptText="Entrer votre nom" prefWidth="150.0" />
        </children>
    </HBox>

    <Label fx:id="l_welcomeText" text="Bienvenue !" />
    <Button text="Dire Bonjour" onAction="#onHelloButtonClick" />
</VBox>
