<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<!-- ici VBox est le type de panel choisi pour représenter le panel principal associé à la classe qui la contrôle-->

<VBox alignment="CENTER" spacing="20.0" xmlns:fx="http://javafx.com/fxml/1" xmlns="http://javafx.com/javafx/23.0.1" fx:controller="fr.esiee.javafxtest.HelloController">
  <padding>
    <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
  </padding>
   <HBox prefHeight="100.0" prefWidth="200.0">
      <children>
         <Label text="Nom:" />
         <TextField fx:id="tf_inputName" />
      </children>
   </HBox> <!-- welcomeText sera une variable de type Label -->
  <!-- chaque objet graphique qui réagit à un event, il faut mentionner la méthode déléguée si ca arrive -->
  <Button onAction="#onHelloButtonClick" text="Hello!" />
<!-- fx:id permet de donner un nom de variable du type de l'objet graphique-->
  <!-- un objet graphique auquel on a besoin d'accéder en lecture ou en modification, doit avoir un fx:id -->
  <Label fx:id="l_welcomeText" />
</VBox>
